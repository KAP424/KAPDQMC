python extend_errors.py --tol 0.03 --budget 6 --jobs 11   # 按误差买样本（每点串行）
python run_shards.py --tol 0.05 --budget 34 --workers 14  # 分片并行版；贵点拆成 14 片
python merge_shards.py                                    # 把分片并回 CSV
python extend_run.py --jobs 13          # 备选：按每 L 固定目标样本数
python headline_numbers.py              # §4.1/§10.3 的全部数字（唯一口径）
python summary_figure.py
python crossover_structure.py
python two_regime_check.py              # §7.5 的两端预言（从 CSV 现算，无硬编码）
python small_z_mechanism.py
python mechanism_figures.py
python linear_z_figure.py               # 线性坐标的角贡献图（§6.6）
python beta_corner_figure.py            # 角贡献随 beta，beta 作图例（§4.2b）
python pj_collapse_figure.py            # 坍缩的两个条件（§6.7、§9.4）
python tables_to_figures.py             # §3.8/§4.1/§4.3/§4.4/§5.3/§5.5/§5.6 的图
python headline_numbers.py              # §4.4 的置换检验在这里

# 一维
cd src/Measure/born_ai/research_20261101_1d
python check_onedim.py
python exact_L9.py
python run_onedim_big.py matched 32768 13
python run_onedim_big.py fixed   32768 13
python run_smallz_hires.py 262144 3      # z=0.03, 0.1 两行加密（~2 CPU-h）
python run_large_L.py 3000
python fit_weak_big.py
python make_figures.py
python xxz_collapse.py 14               # §5.4b XXZ 全枚举，~30 s
python xxz_tail.py 14                   # §5.4b 重尾矩 w4，~2 min
python ff_nonpert.py 20000              # §5.4 典型 r 的诊断
